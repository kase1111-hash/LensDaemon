<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for Android 12 and higher (android:dataExtractionRules).
    Same exclusions as backup_rules.xml: the encrypted S3/SMB settings (their key stays in
    this phone's keystore) and the upload queue (its recordings stay on this phone).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lensdaemon_credentials.xml" />
        <exclude domain="sharedpref" path="upload_queue.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lensdaemon_credentials.xml" />
        <exclude domain="sharedpref" path="upload_queue.xml" />
    </device-transfer>
</data-extraction-rules>
